                        "dataset": "twitch_analytics",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  stream_sessions.channel_name AS channel_name,\r\n  stream_sessions.started_at AS start_time,\r\n  FLOOR(\r\n    EXTRACT(\r\n      EPOCH FROM (\r\n        chat_messages.event_time - stream_sessions.started_at\r\n      ) \r\n    ) / 60\r\n  ) AS stream_minute,\r\n  COUNT(*) AS message_count\r\nFROM chat_messages\r\nJOIN stream_sessions\r\nON chat_messages.stream_id = stream_sessions.stream_id\r\nWHERE stream_sessions.channel_name = '${channel_name}'\r\nGROUP BY stream_sessions.stream_id, stream_minute\r\nORDER BY stream_minute;",
                        "sql": {
